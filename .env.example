DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/tipsathi?schema=public"
AUTH_SECRET="replace-with-at-least-32-random-characters"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"

# Set true only behind a proxy that replaces forwarded-IP headers (for example Vercel).
TRUST_PROXY_HEADERS="false"

# Production GENERIC_API POS hosts, comma separated. Exact hostnames only.
POS_OUTBOUND_HOST_ALLOWLIST=""

# Generate with: openssl rand -base64 32
# Must decode to exactly 32 bytes. Changing it makes saved POS credentials unreadable.
POS_CREDENTIAL_ENCRYPTION_KEY=""
